5,20,35,50 * * * * root php /var/www/html/bin/console mautic:campaigns:update 2>&1 | tee -a /proc/1/fd/1

# Contacts Scheduled Export - cada 3 min
*/3 * * * * root php /var/www/html/bin/console mautic:contacts:scheduled_export 2>&1 | tee -a /proc/1/fd/1

