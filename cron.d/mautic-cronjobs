SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
BASH_ENV=/tmp/cron.env
# ---------------------------
# Tus comandos (prioridad)
# ---------------------------
# Segments Update - cada minuto

* * * * * root php /var/www/html/bin/console mautic:segments:update --batch-limit=500 2>&1 | tee -a /proc/1/fd/1

# Import Contacts - cada 5 min
*/5 * * * * root php /var/www/html/bin/console mautic:import 2>&1 | tee -a /proc/1/fd/1

# Campaigns Rebuild - cada minuto
* * * * * root php /var/www/html/bin/console mautic:campaigns:rebuild 2>&1 | tee -a /proc/1/fd/1

# Campaigns Trigger - cada minuto
* * * * * root php /var/www/html/bin/console mautic:campaigns:trigger 2>&1 | tee -a /proc/1/fd/1

# Messages Send - cada minuto
* * * * * root php /var/www/html/bin/console mautic:messages:send 2>&1 | tee -a /proc/1/fd/1

# Email Fetch - cada 15 min
0,15,30,45 * * * * root php /var/www/html/bin/console mautic:email:fetch 2>&1 | tee -a /proc/1/fd/1

# Social Monitoring - cada 15 min
0,15,30,45 * * * * root php /var/www/html/bin/console mautic:social:monitoring 2>&1 | tee -a /proc/1/fd/1

# Webhooks Process - cada 15 min
0,15,30,45 * * * * root php /var/www/html/bin/console mautic:webhooks:process 2>&1 | tee -a /proc/1/fd/1

# Broadcasts Send - cada 15 min
0,15,30,45 * * * * root php /var/www/html/bin/console mautic:broadcasts:send 2>&1 | tee -a /proc/1/fd/1

# Cleanup - diario a la 1 AM
* 1 * * * root php /var/www/html/bin/console mautic:maintenance:cleanup --days-old=365 2>&1 | tee -a /proc/1/fd/1

# IP Lookup Download - el día 15 de cada mes a las 4 AM
0 4 15 * * root php /var/www/html/bin/console mautic:iplookup:download 2>&1 | tee -a /proc/1/fd/1

# Reports Scheduler - cada 5 min
*/5 * * * * root php /var/www/html/bin/console mautic:reports:scheduler 2>&1 | tee -a /proc/1/fd/1

# Unused IP Delete - el día 10 de cada mes a las 5:00 AM
0 5 10 * * root php /var/www/html/bin/console mautic:unusedip:delete 2>&1 | tee -a /proc/1/fd/1


# ---------------------------
# Comandos oficiales que faltaban (los dejo como referencia)
